 "recenice": [
  {
   "g": "A",
   "od": 0.35,
   "do": 5.217,
   "tekst": "Bok svima, dobrodošli u novu epizodu podcasta Sunčani četiri M."
  },
  {
   "g": "B",
   "od": 5.567,
   "do": 9.258,
   "tekst": "Hvala na pozivu, drago mi je što sam danas ovdje s vama."
  },
  {
   "g": "A",
   "od": 9.608,
   "do": 13.596,
   "tekst": "Pričaj nam malo kako je počela tvoja priča s glazbom."
  },
  {
   "g": "B",
   "od": 13.946,
   "do": 17.954,
   "tekst": "Počelo je u garaži, svirali smo svaki vikend do kasno u noć."
  },
  {
   "g": "C",
   "od": 18.304,
   "do": 23.674,
   "tekst": "Ja sam tada svirao bubnjeve, a susjedi baš i nisu bili oduševljeni."
  },
  {
   "g": "A",
   "od": 24.024,
   "do": 26.797,
   "tekst": "I onda ste odlučili snimiti prvi album?"
  },
  {
   "g": "B",
   "od": 27.147,
   "do": 30.842,
   "tekst": "Da, ali trebalo nam je skoro dvije godine da ga završimo."
  },
  {
   "g": "C",
   "od": 31.192,
   "do": 32.535,
   "tekst": "Točno tako."
  },
  {
   "g": "A",
   "od": 32.885,
   "do": 37.248,
   "tekst": "To je dugo. Što je bilo najteže u cijelom tom procesu?"
  },
  {
   "g": "C",
   "od": 37.598,
   "do": 42.685,
   "tekst": "Najteže je bilo pronaći vrijeme, jer smo svi radili druge poslove."
  },
  {
   "g": "B",
   "od": 43.035,
   "do": 45.937,
   "tekst": "I novac, studio u Zagrebu nije bio jeftin."
  },
  {
   "g": "A",
   "od": 46.287,
   "do": 50.558,
   "tekst": "Razumijem. Hajde onda zasvirajte nešto za nas u autu."
  },
  {
   "g": "B",
   "od": 50.908,
   "do": 54.292,
   "tekst": "Može, ovo je pjesma o Kutini i ljetu na Moslavini."
  }
